      }
    },
    "de.bmw.infotainment.drivingexcitement.Efficiencytainment2": {
      "instances": "1",
      "attributes": {
        "statusBatteryTemperature": "rs"
      }
    },
    "de.bmw.infotainment.lsc.LSCDataSink": {
      "instances": "1",
      "attributes": {
        "statusHighVoltageStorage": "s"
      }
    }
  },
  "services": {
    "de.bmw.infotainment.telematic.oap.AppStatus": {
      "instances": [
        "${userId}"
      ]
    },
    "de.bmw.infotainment.telematic.oap.TriggersControl": {
      "instances": [
        "${userId}"
      ]
    }
  }
}