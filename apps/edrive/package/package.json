{
  "name": "edrive",
  "version": "2.9.4",
  "description": "Real electric range, live battery power, cells and climate power, HV battery health (SOH) and energy, last charge, charge log, the 12 V battery (charge, voltage, what it does, regen, history) and a home-screen widget; on a 48 V mild hybrid its 48 V battery and DC/DC converter",
  "main": "javascript/localized-entry.js",
  "private": false,
  "author": "custom",
  "license": "MIT",
  "engines": {
    "node": ">=8.7.0"
  },
  "oapAppSettings": {
    "maxDiskUsage": 20971520,
    "cpuLimit": 60,
    "memoryThresholdKB": 196608,
    "priority": "PRIO_LOW",
    "visibility": "FOREGROUND",
    "latencyClass": "FOREGROUND",
    "loggingId": "OA9C",
    "userLoginRequired": false,
    "backgroundPriority": 200,
    "someipManifest": "manifest.json"
  },
  "mguLocalOnly": true,
  "files": [
    "package.json",
    "npm-shrinkwrap.json",
    "manifest.json",
    "permissions.json",
    "config",
    "javascript",
    "rhmiData",
    "LICENSE",
    "NOTICE.zh-CN.md",
    "PROVENANCE.json",
    "CHANGELOG.md",
    "rhmiDataStartWidget"
  ]
}
