{
  "name": "dtc_scanner",
  "version": "2.15.2",
  "description": "Read and clear fault memory of every control unit, what each unit kept about a fault, how fast units answer, plus active Check Control messages and values that do not fit together or arrive late",
  "main": "javascript/localized-entry.js",
  "private": false,
  "author": "cauliflowermossgrape",
  "license": "MIT",
  "engines": {
    "node": ">=8.7.0"
  },
  "oapAppSettings": {
    "maxDiskUsage": 20971520,
    "cpuLimit": 60,
    "memoryThresholdKB": 196608,
    "priority": "PRIO_LOW",
    "visibility": "FOREGROUND",
    "latencyClass": "FOREGROUND",
    "loggingId": "OA95",
    "userLoginRequired": false,
    "backgroundPriority": 200,
    "someipManifest": "manifest.json"
  },
  "mguLocalOnly": true,
  "files": [
    "package.json",
    "npm-shrinkwrap.json",
    "manifest.json",
    "permissions.json",
    "config",
    "javascript",
    "rhmiData",
    "LICENSE",
    "NOTICE.zh-CN.md",
    "PROVENANCE.json",
    "CHANGELOG.md",
    "ATTRIBUTION.json",
    "CONTRIBUTORS.zh-CN.md"
  ]
}
