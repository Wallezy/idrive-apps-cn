{
  "name": "jap_ridetube",
  "version": "0.3.9",
  "description": "ID7 非官方 YouTube 客户端，支持搜索、频道、章节及登录后的首页、订阅和稍后观看。通过车机播放声音，默认停车时显示画面。需要 jap-ridetube-d 服务。",
  "main": "javascript/localized-entry.js",
  "private": false,
  "author": "custom",
  "license": "GPL-3.0-or-later",
  "engines": {
    "node": ">=8.7.0"
  },
  "oapAppSettings": {
    "maxDiskUsage": 20971520,
    "cpuLimit": 60,
    "memoryThresholdKB": 196608,
    "priority": "PRIO_LOW",
    "visibility": "FOREGROUND",
    "latencyClass": "FOREGROUND",
    "loggingId": "OAA6",
    "userLoginRequired": false,
    "backgroundPriority": 200,
    "someipManifest": "manifest.json"
  },
  "mguLocalOnly": true,
  "files": [
    "CHANGELOG.md",
    "LICENSE",
    "LICENSE.kit",
    "NOTICE.zh-CN.md",
    "PROVENANCE.json",
    "THIRD_PARTY_LICENSES",
    "config",
    "javascript",
    "manifest.json",
    "npm-shrinkwrap.json",
    "package.json",
    "permissions.json",
    "rhmiData"
  ]
}
