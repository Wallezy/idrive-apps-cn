{
  "id": "dpf_monitor",
  "title": "颗粒捕集器监测",
  "version": "0.3.3",
  "screens": [
    {
      "name": "MAIN",
      "kind": "canvas",
      "title": "颗粒捕集器监测",
      "buttons": [
        [
          "BTN_PAGE",
          "下一页"
        ],
        [
          "BTN_ACTION",
          "刷新"
        ],
        [
          "BTN_SETTINGS",
          "设置"
        ]
      ]
    }
  ],
  "settings": [
    {
      "key": "variantPolicy",
      "label": "DDE 型号",
      "type": "choice",
      "default": "verified",
      "options": [
        [
          "verified",
          "仅限已验证的 D70 / D75 / D83"
        ],
        [
          "compatible",
          "尝试兼容 DDE（未验证）"
        ]
      ]
    },
    {
      "key": "liveInterval",
      "label": "实时刷新间隔",
      "type": "number",
      "unit": "s",
      "default": 2,
      "steps": [
        1,
        2,
        3,
        5,
        10
      ]
    },
    {
      "key": "regenTarget",
      "label": "预计再生结束时的积碳量",
      "type": "number",
      "unit": "g",
      "default": 6,
      "markDefault": true,
      "steps": [
        4,
        5,
        6,
        7,
        8,
        10
      ]
    },
    {
      "key": "tempUnit",
      "label": "温度",
      "type": "choice",
      "default": "C",
      "options": [
        [
          "C",
          "摄氏"
        ],
        [
          "F",
          "华氏"
        ]
      ]
    },
    {
      "key": "theme",
      "label": "配色主题",
      "type": "choice",
      "default": "m_tricolour",
      "options": [
        [
          "m_tricolour",
          "M 三色"
        ],
        [
          "ice",
          "冰晶白"
        ],
        [
          "amber",
          "夜间琥珀"
        ],
        [
          "m_red",
          "M 红色"
        ]
      ]
    },
    {
      "key": "demo",
      "label": "演示数据",
      "type": "choice",
      "default": "off",
      "reset": 1,
      "options": [
        [
          "off",
          "从不"
        ],
        [
          "on",
          "始终"
        ]
      ]
    },
    {
      "key": "layout",
      "label": "屏幕布局",
      "type": "choice",
      "default": "full",
      "reset": 2,
      "options": [
        [
          "full",
          "全屏"
        ]
      ]
    },
    {
      "key": "renderer",
      "label": "渲染器",
      "type": "choice",
      "default": "auto",
      "reset": 2,
      "options": [
        [
          "auto",
          "GPU 60 帧／秒"
        ]
      ]
    }
  ],
  "config": {
    "ddeAddress": 18,
    "readOnly": true,
    "fullScreenRequired": true
  },
  "startWidget": null,
  "stateIds": {
    "MAIN": 1,
    "SETTINGS": 10
  }
}
