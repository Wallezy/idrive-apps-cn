{
  "name": "cluster_themes",
  "version": "0.17.3",
  "description": "12 套仪表主题，支持驾驶模式切换、自定义数据及 Waze 地图。中控操作简体中文，保留原版仪表风格。",
  "main": "javascript/localized-entry.js",
  "private": false,
  "author": "custom",
  "license": "MIT",
  "engines": {
    "node": ">=8.7.0"
  },
  "oapAppSettings": {
    "maxDiskUsage": 20971520,
    "cpuLimit": 60,
    "memoryThresholdKB": 196608,
    "priority": "PRIO_LOW",
    "visibility": "FOREGROUND",
    "latencyClass": "FOREGROUND",
    "loggingId": "OAC1",
    "userLoginRequired": false,
    "backgroundPriority": 200,
    "someipManifest": "manifest.json"
  },
  "mguLocalOnly": true,
  "files": [
    "package.json",
    "npm-shrinkwrap.json",
    "manifest.json",
    "permissions.json",
    "config",
    "javascript",
    "rhmiData",
    "LICENSE",
    "MPL-2.0.txt",
    "NOTICE",
    "NOTICE.zh-CN.md",
    "provenance.json",
    "CHANGELOG.md"
  ]
}
