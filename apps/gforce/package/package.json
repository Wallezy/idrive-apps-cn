{
  "name": "gforce",
  "version": "1.7.2",
  "description": "Friction circle with grip envelope, peak g per direction and session records, and the last minute of driving saved when it matters, with replay",
  "main": "javascript/localized-entry.js",
  "private": false,
  "author": "cauliflowermossgrape",
  "license": "MIT",
  "engines": {
    "node": ">=8.7.0"
  },
  "oapAppSettings": {
    "maxDiskUsage": 20971520,
    "cpuLimit": 60,
    "memoryThresholdKB": 196608,
    "priority": "PRIO_LOW",
    "visibility": "FOREGROUND",
    "latencyClass": "FOREGROUND",
    "loggingId": "OA9B",
    "userLoginRequired": false,
    "backgroundPriority": 200,
    "someipManifest": "manifest.json"
  },
  "mguAppStartType": "autostart",
  "mguLocalOnly": true,
  "files": [
    "package.json",
    "npm-shrinkwrap.json",
    "manifest.json",
    "permissions.json",
    "config",
    "javascript",
    "rhmiData",
    "LICENSE",
    "NOTICE.zh-CN.md",
    "PROVENANCE.json",
    "CHANGELOG.md",
    "ATTRIBUTION.json",
    "CONTRIBUTORS.zh-CN.md"
  ]
}
