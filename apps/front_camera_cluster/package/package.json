{
  "name": "front_camera_cluster",
  "version": "0.2.2",
  "description": "全屏控制宝马夜视和泊车摄像头在仪表中的显示",
  "main": "javascript/localized-entry.js",
  "private": false,
  "author": "alexp50",
  "license": "MIT",
  "engines": {
    "node": ">=8.7.0"
  },
  "oapAppSettings": {
    "maxDiskUsage": 20971520,
    "cpuLimit": 60,
    "memoryThresholdKB": 196608,
    "priority": "PRIO_LOW",
