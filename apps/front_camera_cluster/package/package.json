    "loggingId": "OAB2",
    "userLoginRequired": false,
    "backgroundPriority": 200,
    "someipManifest": "manifest.json"
  },
  "mguLocalOnly": true,
  "files": [
    "CHANGELOG.md",
    "NOTICE.zh-CN.md",
    "PROVENANCE.json",
    "config",
    "javascript",
    "manifest.json",
    "npm-shrinkwrap.json",
    "package.json",
    "permissions.json",
    "rhmiData",
    "LICENSE"
  ]
}
