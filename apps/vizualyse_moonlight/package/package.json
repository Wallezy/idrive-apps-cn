{
  "name": "vizualyse_moonlight",
  "version": "0.3.101",
  "description": "连接 Sunshine 主机，将电脑游戏和声音串流到车机。",
  "private": false,
  "main": "javascript/runner.js",
  "oapAppSettings": {
    "maxDiskUsage": 26214400,
    "cpuLimit": 50,
    "memoryThresholdKB": 153600,
    "priority": "PRIO_MEDIUM",
    "visibility": "FOREGROUND",
    "latencyClass": "FOREGROUND",
    "loggingId": "VMLT",
    "userLoginRequired": false,
    "backgroundPriority": 150,
    "someipManifest": "manifest.json"
  },
  "files": [
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE.zh-CN.md",
    "PROVENANCE.json",
    "config",
    "manifest.json",
    "npm-shrinkwrap.json",
    "package.json",
    "permissions.json",
    "rhmiData"
  ],
  "dependencies": {
    "oap-sdk": "24.10.2"
  },
  "engines": {
    "node": ">=8.7.0"
  },
  "keywords": [
    "node",
    "BMW",
    "Online",
    "ConnectedDrive"
  ],
  "author": "Yousaf Khan",
  "license": "GPL-3.0-or-later",
  "mguLocalOnly": true
}
