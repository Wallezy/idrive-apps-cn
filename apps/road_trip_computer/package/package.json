{
  "name": "road_trip_computer",
  "version": "1.0.2",
  "description": "全屏显示行程历史、油耗、油价、费用、续航、车外温度和 GPS 海拔",
  "main": "javascript/localized-entry.js",
  "private": false,
  "author": "alexp50 / bmw-apps contributors",
  "license": "MIT",
  "engines": {
    "node": ">=8.7.0"
  },
  "oapAppSettings": {
    "maxDiskUsage": 20971520,
    "cpuLimit": 60,
    "memoryThresholdKB": 196608,
    "priority": "PRIO_LOW",
    "visibility": "FOREGROUND",
    "latencyClass": "FOREGROUND",
    "loggingId": "OAB5",
    "userLoginRequired": false,
    "backgroundPriority": 200,
    "someipManifest": "manifest.json"
  },
  "mguLocalOnly": true,
  "files": [
    "CHANGELOG.md",
    "NOTICE.zh-CN.md",
    "PROVENANCE.json",
    "config",
    "javascript",
    "manifest.json",
    "npm-shrinkwrap.json",
    "package.json",
    "permissions.json",
    "rhmiData",
    "rhmiDataStartWidget",
    "LICENSE",
    "ATTRIBUTION.json",
    "CONTRIBUTORS.zh-CN.md"
  ]
}
