{
  "name": "telemetry_studio",
  "version": "0.2.1",
  "description": "分类全屏显示动力、热管理、底盘、轮胎、空调和电气实时数据",
  "main": "javascript/localized-entry.js",
  "private": false,
  "author": "alexp50",
  "license": "MIT",
  "engines": {
    "node": ">=8.7.0"
  },
  "oapAppSettings": {
    "maxDiskUsage": 20971520,
    "cpuLimit": 60,
    "memoryThresholdKB": 196608,
    "priority": "PRIO_LOW",
    "visibility": "FOREGROUND",
    "latencyClass": "FOREGROUND",
    "loggingId": "OAA9",
    "userLoginRequired": false,
    "backgroundPriority": 200,
    "someipManifest": "manifest.json"
  },
  "mguLocalOnly": true,
  "files": [
    "CHANGELOG.md",
    "NOTICE.zh-CN.md",
    "PROVENANCE.json",
    "config",
    "javascript",
    "manifest.json",
    "npm-shrinkwrap.json",
    "package.json",
    "permissions.json",
    "rhmiData",
    "LICENSE"
  ]
}
