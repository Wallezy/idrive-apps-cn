{
  "name": "sys_monitor",
  "version": "1.0.9",
  "description": "查看车机内存、处理器、温度和进程占用，支持排序与趋势图；只读监控。",
  "main": "javascript/localized-entry.js",
  "private": false,
  "author": "custom",
  "license": "GPL-3.0-or-later",
  "engines": {
    "node": ">=8.7.0"
  },
  "oapAppSettings": {
    "maxDiskUsage": 20971520,
    "cpuLimit": 60,
    "memoryThresholdKB": 196608,
    "priority": "PRIO_LOW",
    "visibility": "FOREGROUND",
    "latencyClass": "FOREGROUND",
    "loggingId": "OASM",
    "userLoginRequired": false,
    "backgroundPriority": 200,
    "someipManifest": "manifest.json"
  },
  "mguLocalOnly": true,
  "files": [
    "package.json",
    "npm-shrinkwrap.json",
    "manifest.json",
    "permissions.json",
    "config",
    "javascript",
    "rhmiData",
    "LICENSE",
    "LICENSE.MIT",
    "NOTICE.zh-CN.md",
    "PROVENANCE.json",
    "CHANGELOG.md"
  ]
}
