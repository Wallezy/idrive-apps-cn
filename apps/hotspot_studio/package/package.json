{
  "name": "hotspot_studio",
  "version": "0.1.6",
  "description": "通过宝马热点提供华为网络代理，并按需开启单客户端限时 ENET 转发",
  "main": "javascript/localized-entry.js",
  "private": false,
  "author": "alexp50",
  "license": "MIT",
  "engines": {
    "node": ">=8.7.0"
  },
  "oapAppSettings": {
    "maxDiskUsage": 20971520,
    "cpuLimit": 60,
    "memoryThresholdKB": 196608,
    "priority": "PRIO_LOW",
    "visibility": "FOREGROUND",
    "latencyClass": "FOREGROUND",
    "loggingId": "OAB7",
    "userLoginRequired": false,
    "backgroundPriority": 200,
    "someipManifest": "manifest.json"
  },
  "mguLocalOnly": true,
  "files": [
    "CHANGELOG.md",
    "NOTICE.zh-CN.md",
    "PROVENANCE.json",
    "config",
    "javascript",
    "manifest.json",
    "npm-shrinkwrap.json",
    "package.json",
    "permissions.json",
    "rhmiData",
    "LICENSE"
  ]
}
