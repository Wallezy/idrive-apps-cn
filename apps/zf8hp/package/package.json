{
  "name": "zf8hp",
  "version": "1.5.11",
  "description": "Transmission Config, experimental ZF 8HP monitor: live data, clutch fill adaptations, shift maps and temperature history",
  "main": "javascript/localized-entry.js",
  "private": false,
  "author": "custom",
  "license": "MIT",
  "engines": {
    "node": ">=8.7.0"
  },
  "oapAppSettings": {
    "maxDiskUsage": 20971520,
    "cpuLimit": 60,
    "memoryThresholdKB": 196608,
    "priority": "PRIO_LOW",
    "visibility": "FOREGROUND",
    "latencyClass": "FOREGROUND",
    "loggingId": "OAA2",
    "userLoginRequired": false,
    "backgroundPriority": 200,
    "someipManifest": "manifest.json"
  },
  "mguLocalOnly": true,
  "files": [
    "package.json",
    "npm-shrinkwrap.json",
    "manifest.json",
    "permissions.json",
    "config",
    "javascript",
    "rhmiData",
    "LICENSE",
    "NOTICE.zh-CN.md",
    "PROVENANCE.json",
    "CHANGELOG.md"
  ]
}
