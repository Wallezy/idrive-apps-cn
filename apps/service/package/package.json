{
  "name": "service",
  "version": "1.7.2",
  "description": "Service requirements from the instrument cluster: oil, brakes, brake fluid, vehicle check, inspection - distance, date, details; brake fluid and vehicle check reset; your own intervals, wheels, the 12 V battery, refuels, parts and milestones",
  "main": "javascript/localized-entry.js",
  "private": false,
  "author": "cauliflowermossgrape",
  "license": "MIT",
  "engines": {
    "node": ">=8.7.0"
  },
  "oapAppSettings": {
    "maxDiskUsage": 20971520,
    "cpuLimit": 60,
    "memoryThresholdKB": 196608,
    "priority": "PRIO_LOW",
    "visibility": "FOREGROUND",
    "latencyClass": "FOREGROUND",
    "loggingId": "OA96",
    "userLoginRequired": false,
    "backgroundPriority": 200,
    "someipManifest": "manifest.json"
  },
  "mguAppStartType": "autostart",
  "mguLocalOnly": true,
  "files": [
    "package.json",
    "npm-shrinkwrap.json",
    "manifest.json",
    "permissions.json",
    "config",
    "javascript",
    "rhmiData",
    "LICENSE",
    "NOTICE.zh-CN.md",
    "PROVENANCE.json",
    "CHANGELOG.md",
    "ATTRIBUTION.json",
    "CONTRIBUTORS.zh-CN.md"
  ]
}
