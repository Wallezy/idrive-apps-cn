{
  "proxies": {
    "de.bmw.infotainment.hmi.entrypoint.EntryPoint": "*",
    "de.bmw.infotainment.hmi.entrypoint.EntryPointManager": "*",
    "de.bmw.infotainment.hmi.remote.RemoteHmi": "*",
    "de.bmw.infotainment.hmi.remote.RemoteHmiApplication": "*",
    "de.bmw.infotainment.hmi.resourcemanagement.ResourceBundle": "*",
    "de.bmw.infotainment.hmi.resourcemanagement.ResourceManager": "*",
    "de.bmw.infotainment.hmi.resourcemanagement.StringBundle": "*",
    "de.bmw.infotainment.hmi.usecasemanagement.UseCaseInstance": "*",
    "de.bmw.infotainment.hmi.usecasemanagement.UseCaseProvider": "*",
    "de.bmw.infotainment.hmi.usecasemanagement.UseCaseRegistry": {
      "attributes": {
        "useCaseIds": "r"
      },
      "broadcasts": [
        "registryUpdate"
      ],
      "instances": "*",
      "methods": [
        "getProvider"
      ]
    },
    "de.bmw.infotainment.lifecycle.lifecycle.Lifecycle": {
      "instances": "Front",
      "attributes": {
        "rseHmiMenu": "rws",
        "rseLock": "rws",
        "rseLowPowerMode": "rws",
        "theatreMode": "rws"
      },
      "methods": [
        "requestRSE",
        "requestRSEEntertainmentMode"
      ]
    },
    "de.bmw.infotainment.personalization.SessionManager": "*",
    "de.bmw.infotainment.personalization.UserAccount": {
      "attributes": {
        "firstName": "rs",
        "gcid": "rs",
        "id": "r",
        "name": "rs",
        "type": "r"
      },
      "broadcasts": [
        "requestUpdateConnectedDriveCredentials"
      ],
      "instances": "*"
    },
    "de.bmw.infotainment.dataprivacy.privacysettings.PrivacySettings": {
      "attributes": {
        "allSettings": "rs"
      },
      "instances": "1",
      "methods": [
        "addOrUpdateSetting",
        "setDynamicAvailable",
        "setDynamicEnable"
      ]
    },
    "de.bmw.infotainment.telematic.oap.AppBookmarks": {
      "instances": [
        "${userId}"
      ],
      "methods": [
        "registerBookmark"
      ]
    },
    "de.bmw.infotainment.telematic.oap.PrivateEntryPoint": {
      "instances": [
        "${userId}"
      ],
      "methods": [
        "registerEntryPoint",
        "unregisterEntryPoint",
        "setSelected",
        "setAvailability"
      ]
    },
    "de.bmw.infotainment.telematic.oap.WakeUpOnDemand": {
      "instances": [
        "${userId}"
      ],
      "methods": [
        "registerParticipant",
        "unregisterParticipant"
      ]
    },
    "de.bmw.infotainment.telematic.oap.WodControl": {
      "instances": "${userId}",
      "methods": [
        "offerService",
        "stopOfferingService"
      ]
    },
    "de.bmw.infotainment.telematic.oapcontroller.OAPController": "*",
    "de.bmw.infotainment.telematic.provisioning.Provisioning": {
      "broadcasts": [
        "provisioningDataJSON"
      ],
      "instances": "1",
      "methods": [
        "getValueJSON",
        "setFilterForProvisioningData"
      ]
    },
    "de.bmw.infotainment.vehicle.Vehicle": {
      "attributes": {
        "statusNewCurrentUnitsStatusExt": "rs"
      },
      "instances": "1"
    },
    "de.bmw.infrastructure.EnvironmentalInformation": {
      "attributes": {
        "UnitBN2020": "rs"
      },
      "instances": "1"
    },
    "org.genivi.nodestatemanager.Consumer": {
      "broadcasts": [
        "ShutdownEvents",
        "SessionStateChanged"
      ],
      "instances": "NSMConsumer",
      "methods": [
        "LifecycleRequestComplete",
        "RegisterShutdownClient",
        "UnRegisterShutdownClient"
      ]
    },
    "de.bmw.infotainment.climate.Climate": {
      "instances": "1",
      "attributes": {
        "climateFond": "w",
        "acFond": "w",
        "seatHeatingLamination": "w",
        "statusClimateFond": "rs",
        "statusACFond2": "rs",
        "statusSeatHeatingDRR": "rs",
        "statusSeatHeatingPSR": "rs",
        "statusSeatClimateDRR": "rs",
        "statusSeatClimatePSR": "rs",
        "acSpecialFunction": "w",
        "statusACFront": "rs"
      }
    },
    "de.bmw.infotainment.misc.SeatFunction": {
      "instances": "1",
      "attributes": {
        "controlSeatAdjustment": "w",
        "controlSeatMemory": "w",
        "statusRequestMMIDisplay": "rs"
      }
    },
    "de.bmw.infotainment.misc.ComfortFunctionIuK": {
      "instances": "1",
      "attributes": {
        "seatMassageRL": "w",
        "seatMassageRR": "w",
        "adjustmentLumbarRL": "w",
        "adjustmentLumbarRR": "w",
        "statusSeatMassageRL": "rs",
        "statusSeatMassageRR": "rs",
        "statusAdjustmentLumbarRL": "rs",
        "statusAdjustmentLumbarRR": "rs",
        "seatAdjustmentDRR": "w",
        "seatAdjustmentPSR": "w"
      }
    },
    "de.bmw.infotainment.vehicle.A4A": {
      "instances": "1",
      "attributes": {
        "sunblind": "w",
        "statusSunblind": "rs"
      }
    },
    "com.harman.infotainment.systeminfrastructure.seatcommandproxy.seatcommandproxy.SeatCommandProxyCtrl": {
      "instances": "Inst1",
      "attributes": {
        "seatProxySeatOperationStatus": "rs"
      },
      "methods": [
        "startSeatOperation",
        "aliveSeatOperation",
        "stopSeatOperation"
      ]
    },
    "de.bmw.infotainment.lifecycle.lifecyclerse.LifecycleRSE": {
      "instances": "Rear",
      "attributes": {
        "focusIndicatorHMI": "rws",
        "powerStateDetailedLeft": "rs",
        "powerStateDetailedRight": "rs"
      },
      "methods": [
        "requestEntertainmentModeLeft",
        "requestEntertainmentModeRight",
        "leaveEntertainmentModeLeft",
        "leaveEntertainmentModeRight"
      ]
    },
    "de.bmw.infotainment.rseapplicationcontrol.RSEApplicationControl": {
      "instances": "3",
      "attributes": {
        "launchableApps": "rs"
      },
      "methods": [
        "launchApp"
      ]
    },
    "de.bmw.infotainment.rsecommandcontrol.RSECommandControl": {
      "instances": "3",
      "attributes": {
        "currentVolume": "rs",
        "rseMainSinkAudible": "rws"
      },
      "methods": [
        "setVolumeStep"
      ]
    },
    "de.bmw.infotainment.rsedisplaycontrol.RSEDisplayControl": {
      "instances": "3",
      "attributes": {
        "displayBrightness": "rws",
        "displayState": "rws",
        "normalModeReady": "rs"
      }
    },
    "de.bmw.infotainment.rseremoteinput.RSERemoteInput": {
      "instances": "3",
      "attributes": {
        "remoteControlEnabled": "rs"
      },
      "methods": [
        "sendCommandKey",
        "sendDirectionKey"
      ]
    }
  },
  "services": {
    "de.bmw.infotainment.telematic.oap.AppStatus": {
      "instances": [
        "${userId}"
      ]
    },
    "de.bmw.infotainment.telematic.oap.TriggersControl": {
      "instances": [
        "${userId}"
      ]
    }
  }
}
