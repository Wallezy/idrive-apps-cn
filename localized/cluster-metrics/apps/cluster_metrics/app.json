{
  "id": "cluster_metrics",
  "title": "Cluster Metrics",
  "description": "Real-time efficiency, HV battery %, powertrain temperatures, gear in D, right-wing Media/Trip widget, HUD turn-by-turn nav, and live DSC hydraulic brake indicator for BMW iDrive 7",
  "version": "0.6.0",
  "vendor": "chyiz",
  "repoTitle": "GitHub Repository",
  "repoLink": "github.com/chyiz/mgu-apps",
  "loggingId": "OA7E",
  "iconGlyph": "cluster_metrics",
  "mguHmi": [
    "ID7"
  ],
  "requires": {
    "cluster-render": "0.4.0"
  },
  "signals": {
    "de.bmw.infotainment.vehicle.CDS": {
      "statusEngineSpeed2": "rs",
      "statusEngineTemperature": "rs"
    },
    "de.bmw.infotainment.vehicle.CDS2": {
      "_optional": "g-force, fuel injection rate and alternate engine oil temp",
      "statusLongitudinalAccelerationMassCenter": "rs",
      "statusLateralAccelerationMassCenter": "rs",
      "statusInjectionVolume": "rs"
    },
    "de.bmw.infotainment.vehicle.Vehicle": {
      "_optional": "BMW display unit configuration (temperature, distance, fuel/EV consumption, tire pressure)",
      "statusNewCurrentUnitsStatusExt": "rs"
    },
    "de.bmw.infotainment.vehicle.Vehicle2": {
      "statusCarSpeed2": "rs",
      "highVoltageStorageInfoToExternal": "s",
      "statusVehicleMass": "rs"
    },
    "de.bmw.chassis.VehicleStabilizationManagement": {
      "_optional": "driver braking switch and ABS intervention for friction-brake blend",
      "StabilizationManagement": "s"
    },
    "de.bmw.powertrain.AcceleratorPedal": {
      "_optional": "pedal angle to gate regen vs active acceleration",
      "AngleAcceleratorPedal": "s"
    },
    "de.bmw.infotainment.drivingexcitement.FES": {
      "_optional": "drive mode, live turbo boost pressure and crankshaft torque",
      "statusFESVehicleDynamicSwitchHMI": "rs",
      "statusSwitchDriveDynamicSport2": "rs",
      "statusActualValueTorque2": "rs"
    },
    "de.bmw.infotainment.drivingexcitement.Efficiencytainment2": {
      "_optional": "PHEV high-voltage battery temperature, charge state, and real-time eDRIVE / regen needle %",
      "statusBatteryTemperature": "rs",
      "statusPowerRelativHybrid": "rs",
      "statusChargeOfBatteryHybrid": "rs"
    },
    "de.bmw.infotainment.lsc.LSCDataSink": {
      "_optional": "PHEV high-voltage battery pack voltage",
      "statusHighVoltageStorage": "s"
    },
    "de.bmw.infrastructure.VehicleCondition": {
      "_optional": "pause UDS polling when car is locked & asleep",
      "VehicleCondition": "s"
    },
    "de.bmw.infotainment.navigation.guiding.Guidance": {
      "_optional": "read BMW navigation route state, turns, lanes & intersection state for HUD navigation",
      "_instances": "Main_Instance",
      "guidanceState": "rs",
      "guidingProvider": "rs",
      "conclusiveDart": "rs",
      "currentLaneGuiding": "rs",
      "nextIntersection": "rs"
    },
    "de.bmw.infotainment.navigation.guiding.GuidanceEventList": {
      "_optional": "read turn-by-turn maneuvers for HUD navigation re-rendering",
      "_instances": "Main_Instance",
      "_methods": [
        "queryContent"
      ]
    },
    "de.bmw.infotainment.navigation.guiding.GuidanceRenderedContent": {
      "_optional": "first-party HUD intersection mini-map / 3D junction view state (HIGH_GUIDING / JUNCTION_VIEW / CITY_HIGHWAY_MAP)",
      "_instances": "Main_Instance",
      "registeredViews": "rs",
      "_methods": [
        "getViewConfig",
        "getViewContent"
      ],
      "_broadcasts": [
        "viewContentChanged"
      ]
    },
    "de.bmw.infotainment.navigation.projectedmodeguiding.ProjectedModeGuiding": {
      "_optional": "detect CarPlay / Android Auto lane guidance",
      "_instances": "Main_Instance",
      "currentLaneGuiding": "rs"
    },
    "de.bmw.infotainment.a4a.carplay.CarPlayManager": {
      "_optional": "detect active Apple Maps / CarPlay route guidance",
      "_instances": "CarPlayManagerInst1",
      "projectedGuidanceActive": "rs"
    },
    "de.bmw.infotainment.sdi.aap.androidautoprojectedmanager.AndroidAutoProjectedManager": {
      "_optional": "detect active Google Maps / Android Auto route guidance",
      "_instances": "AndroidAutoProjectedManagerInst1",
      "projectedGuidanceActive": "rs"
    },
    "de.bmw.infrastructure.VehicleInformation": {
      "_optional": "current gear 1-8 in D and selector stage (P/R/N/D)",
      "statusGearboxDrive": "s",
      "DataPowerTrain2": "s"
    },
    "de.bmw.infotainment.misc.MDrive": {
      "_optional": "S/M gearbox program detection",
      "dataDisplayGearbox": "s"
    },
    "de.bmw.infrastructure.analytics.BasicDataSet": {
      "_optional": "ZF8 transmission oil temperature and xDrive front/rear torque split",
      "basicDataSet": "s"
    },
    "de.bmw.infrastructure.EnvironmentalInformation": {
      "ExteriorTemperature": "s",
      "UnitBN2020": "rs"
    },
    "de.bmw.infotainment.KombiIF": {
      "_optional": "trip consumption, fuel & electric range, BC selection, and electrical power distribution",
      "statusRangeTankStatus": "rs",
      "displayRangeElectricVehicle": "rs",
      "statusBordcomputerAverage": "rs",
      "statusBordcomputerTravelData": "rs",
      "statusBordcomputerElectricData": "rs",
      "statusKombiSelection": "rs",
      "statusDisplayElectricalPowerDistribution": "rs"
    },
    "de.bmw.infotainment.hmi.hmimediastate.HmiMediaState": {
      "_optional": "active media title, artist, playback position, and JPEG/PNG album art across CarPlay/Bluetooth/USB/Radio",
      "_instances": "HMI_CID",
      "playerMetadata": "rs",
      "trackProgress": "rs",
      "coverArt": "rs"
    },
    "de.bmw.infotainment.entertainment.mediaplayer.MediaPlayer": {
      "_optional": "CarPlay media play/pause state and metadata fallback",
      "_instances": "CarPlayMedia",
      "currentItemMetadata": "rs",
      "currentItemTime": "rs",
      "playerState": "rs"
    },
    "de.bmw.body.Light": {
      "_optional": "left steering-column stalk BC button & HBA button tap detection",
      "IndicatorSteeringColumn": "s",
      "IndicatorSteeringColumnComplete": "s",
      "StatusFunctionsIndicators": "s"
    },
    "de.bmw.infotainment.vehicle.TPMS": {
      "_optional": "tire pressures, temperatures and targets for smart alerts",
      "statusTyreTemperature": "rs",
      "statusTyrePressure": "rs",
      "statusTargetTyrePressure": "rs"
    },
    "com.harman.infotainment.systemfunctions.tasu.tasu.InternalTasu": {
      "_optional": "read-only UDS telemetry (HV battery kW/SoC, DME fuel rate, 12V battery, IAT)",
