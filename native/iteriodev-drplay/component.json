{
  "id": "iteriodev-drplay",
  "kind": "tool",
  "version": "1.2.7",
  "title": "行车记录播放服务",
  "description": "为 Drive Recorder 提供摄像头接收、片段播放和 USB 导出。",
  "optional": true,
  "uninstallable": true,
  "requires": {
    "mgu-deploy": "0.8.28",
    "mgu-render": "0.6.28"
  },
  "mguHmi": [
    "ID7"
  ],
  "files": [
    {
      "path": "mgu-drplay",
      "from": "mgu-drplay",
      "mode": "0755"
    },
    {
      "path": "mgu-driverec-rx",
      "from": "mgu-driverec-rx",
      "mode": "0755"
    },
    {
      "path": "setup.sh",
      "from": "setup.sh",
      "mode": "0755"
    },
    {
      "path": "usb-rw.sh",
      "from": "usb-rw.sh",
      "mode": "0755"
    },
    {
      "path": "autostart.sh",
      "from": "autostart.sh",
      "mode": "0755"
    },
    {
      "path": "hmictl",
      "from": "hmictl",
      "mode": "0755"
    },
    {
      "path": "LICENSE.openh264",
      "from": "LICENSE.openh264",
      "mode": "0644"
    },
    {
      "path": "LICENSE.ffmpeg",
      "from": "LICENSE.ffmpeg",
      "mode": "0644"
    },
    {
      "path": "LICENSE.libjpeg-turbo",
      "from": "LICENSE.libjpeg-turbo",
      "mode": "0644"
    },
    {
      "path": "LICENSE.md",
      "from": "LICENSE.md",
      "mode": "0644"
    },
    {
      "path": "PROVENANCE.json",
      "from": "PROVENANCE.json",
      "mode": "0644"
    }
  ],
  "units": [
    {
      "name": "iteriodev-drplay.service",
      "from": "iteriodev-drplay.service"
    },
    {
      "name": "iteriodev-driverec-rx.service",
      "from": "iteriodev-driverec-rx.service"
    }
  ],
  "enable": [
    {
      "unit": "iteriodev-drplay.service",
      "target": "multi-user.target"
    },
    {
      "unit": "iteriodev-driverec-rx.service",
      "target": "multi-user.target"
    }
  ],
  "recmgr": [
    "iteriodev-drplay",
    "iteriodev-driverec-rx"
  ],
  "crashNames": [
    "mgu-drplay",
    "mgu-driverec-rx",
    "hmictl"
  ],
  "restart": [
    "iteriodev-drplay.service",
    "iteriodev-driverec-rx.service"
  ]
}
