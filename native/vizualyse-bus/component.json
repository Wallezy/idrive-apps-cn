{
  "id": "vizualyse-bus",
  "kind": "tool",
  "version": "0.1.1",
  "title": "Vizualyse bus",
  "description": "EXPERIMENTAL. The shared bus the Vizualyse tools use to ask each other to switch things off while they need the car's resources (Steam pauses Cast's cluster and HUD video while a game runs). Mosquitto 2.0.21 (MQTT) on a Unix socket only root's tools can reach; no network listener. Installed with the tools that use it; about 0.2 MB.",
  "files": [
    {
      "path": "mosquitto",
      "mode": "0644",
      "from": ".payload/mosquitto"
    },
    {
      "path": "mosquitto.conf",
      "mode": "0644",
      "from": "files/mosquitto.conf"
    },
    {
      "path": "mosquitto-LICENSE.txt",
      "mode": "0644",
      "from": "files/mosquitto-LICENSE.txt"
    },
    {
      "path": "mosquitto-epl-v20",
      "mode": "0644",
      "from": "files/mosquitto-epl-v20"
    },
    {
      "path": "mosquitto-edl-v10",
      "mode": "0644",
      "from": "files/mosquitto-edl-v10"
    },
    {
      "path": "THIRD-PARTY.md",
      "mode": "0644",
      "from": "files/THIRD-PARTY.md"
    },
    {
      "path": "LICENSE",
      "mode": "0644",
      "from": "files/LICENSE"
    }
  ],
  "units": [
    {
      "name": "vizualyse-bus.service",
      "from": "units/vizualyse-bus.service"
    }
  ],
  "enable": [
    {
      "unit": "vizualyse-bus.service",
      "target": "multi-user.target"
    }
  ],
  "recmgr": [
    "vizualyse-bus"
  ],
  "restart": [
    "vizualyse-bus.service"
  ],
  "mguHmi": [
    "ID7"
  ],
  "crashNames": [
    "mosquitto"
  ],
  "requires": {
    "mgu-deploy": "0.7.0"
  },
  "uninstallable": true,
  "build": [
    "python3",
    "../../tools/materialize_community_payload.py"
  ]
}
